{
  "info": {
    "name": "Multi-Vendor Shopping System API Collection",
    "_postman_id": "a901e412-5582-4a2b-8f12-multivendor10",
    "description": "End-to-end API collection for the Multi-Vendor Shopping System via API Gateway (http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "customerToken", "value": "" },
    { "key": "vendorToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth & User Service",
      "item": [
        {
          "name": "Register Vendor Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dieter Atelier\",\n  \"email\": \"dieter@atelier.com\",\n  \"password\": \"password123\",\n  \"role\": \"VENDOR\"\n}"
            }
          }
        },
        {
          "name": "Login as Demo Vendor 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendor1@atelier.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login as Demo Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@atelier.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Vendor Service",
      "item": [
        {
          "name": "List All Vendors",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/vendors"
          }
        },
        {
          "name": "Register Vendor Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{gatewayUrl}}/api/vendors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Braun Design Archive\",\n  \"email\": \"dieter@atelier.com\",\n  \"contactNumber\": \"+49 6173 300\",\n  \"description\": \"Functional industrial electronics and timepieces.\",\n  \"location\": \"Kronberg, DE\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Product Service",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/products"
          }
        },
        {
          "name": "List Products By Vendor ID",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/products/vendor/1"
          }
        },
        {
          "name": "Create Product (Vendor JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{gatewayUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 1,\n  \"name\": \"Studio Monitor Sub-01\",\n  \"tagline\": \"Deep low-end precision.\",\n  \"description\": \"Sealed acoustic subwoofer in brushed aluminum.\",\n  \"category\": \"Audio\",\n  \"price\": 699.00,\n  \"stockQuantity\": 10\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Order Service",
      "item": [
        {
          "name": "Place Multi-Vendor Order (Customer JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{gatewayUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"1 Infinite Loop, Cupertino, CA 95014\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 },\n    { \"productId\": 3, \"quantity\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{gatewayUrl}}/api/orders/my"
          }
        },
        {
          "name": "Update Order Status (Vendor JWT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{gatewayUrl}}/api/orders/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            }
          }
        }
      ]
    }
  ]
}
